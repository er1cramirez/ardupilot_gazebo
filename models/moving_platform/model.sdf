<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="flat_platform">
    <link name="platform_link">
      <visual name="platform_visual">
        <geometry>
          <box>
            <size>1 1 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name='tag_visual'>
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.6 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://moving_platform/arucotag.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="platform_collision">
        <geometry>
          <box>
            <size>1 1 0.1</size>
          </box>
        </geometry>
      </collision>
      <pose degrees='true'>1 0 0.2 0 0 0</pose>
      <inertial>
          <mass>10000</mass>
          <inertia>
              <ixx>10000</ixx>
              <iyy>10000</iyy>
              <izz>10000</izz>
          </inertia>
      </inertial>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <!-- Velocity control plugin -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <!-- vels for circle moving y=-1 ang_z=-0.2 -->
      <initial_linear>0 0.1 0</initial_linear>
      <initial_angular>0 0 0.1</initial_angular>
      <lin_vel_min>-1 -1 -1</lin_vel_min>
      <lin_vel_max>1 1 1</lin_vel_max>
      <ang_vel_min>-1 -1 -1</ang_vel_min>
      <ang_vel_max>1 1 1</ang_vel_max>
      <link_name>platform_link</link_name>  <!-- Explicitly set the link -->
    </plugin>
  </model>
</sdf>
